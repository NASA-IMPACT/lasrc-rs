#!/usr/bin/env bash
# Check formatting and lints without modifying files (suitable for CI).
# Usage: scripts/lint [rust|python]   (default: both)
set -euo pipefail
cd "$(dirname "$0")/.."

target="${1:-all}"

if [[ "$target" == "all" || "$target" == "rust" ]]; then
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --locked -- -D warnings
fi

if [[ "$target" == "all" || "$target" == "python" ]]; then
    uv run ruff format --check .
    uv run ruff check .
fi
