#!/usr/bin/env bash
# Check that a release tag agrees with the repo (see VERSIONING.md). Run by the Release workflow.
# Usage: scripts/check-versions TAG
#
#   - TAG (e.g. v1.2.3) is a release version (vX.Y.Z)
#   - TAG matches the package version in Cargo.toml
#   - CHANGELOG.md has an entry for TAG
set -euo pipefail
cd "$(dirname "$0")/.."

if [[ $# -ne 1 ]]; then
    echo "usage: scripts/check-versions TAG" >&2
    exit 2
fi
tag=$1
version=${tag#v}

# [workspace.package] version, inherited by every crate and the Python package
package_version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml)

status=0

if [[ ! "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    echo "error: tag $tag is not a release version (vX.Y.Z)" >&2
    status=1
fi
if [[ "$version" != "$package_version" ]]; then
    echo "error: tag $tag does not match Cargo.toml version $package_version" >&2
    status=1
fi
if ! grep -qF "## [$version] - " CHANGELOG.md; then
    echo "error: CHANGELOG.md has no '## [$version] - <date>' entry for tag $tag" >&2
    status=1
fi

exit "$status"
